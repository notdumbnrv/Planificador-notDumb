        function agregarTema() {
            const curso = document.getElementById('est-curso').value;
            const asignatura = document.getElementById('nueva-asignatura').value;
            const tema = document.getElementById('nuevo-tema').value;
            const subtemasSeleccionados = Array.from(document.querySelectorAll('.subtema-select:checked')).map(cb => cb.value);
            const nota = parseFloat(document.getElementById('nueva-nota').value);
            const horas = parseInt(document.getElementById('nuevas-horas').value);
            const fechaExamen = document.getElementById('nueva-fecha-examen').value || null;
            const tiposClase = Array.from(document.querySelectorAll('.tipo-clase:checked')).map(cb => cb.value);
            const comentarios = document.getElementById('nuevos-comentarios').value || '';

            if (!curso || !asignatura || !tema || subtemasSeleccionados.length === 0 || !horas || isNaN(nota)) {
                alert('⚠️ Completa todos los campos obligatorios y selecciona al menos un subtema');
                return;
            }

            let urgente = false;
            if (fechaExamen) {
                const dias = Math.floor((new Date(fechaExamen) - new Date()) / (1000 * 60 * 60 * 24));
                urgente = dias <= 7;
            }

            temasTemp.push({ 
                curso,
                asignatura, 
                tema, 
                subtemas: subtemasSeleccionados,
                nota, 
                horas, 
                fechaExamen, 
                tiposClase,
                comentarios, 
                urgente,
                archivo: archivoApuntes ? archivoApuntes.name : null
            });
            
            // Limpiar
            document.getElementById('nueva-asignatura').value = '';
            document.getElementById('nuevo-tema').value = '';
            document.getElementById('subtemas-disponibles').innerHTML = '<p style="color: #9a3412; font-style: italic;">Primero selecciona un tema</p>';
            document.getElementById('nueva-nota').value = '5';
            document.getElementById('nuevas-horas').value = '2';
            document.getElementById('nueva-fecha-examen').value = '';
            document.querySelectorAll('.tipo-clase').forEach(cb => cb.checked = false);
            document.getElementById('nuevos-comentarios').value = '';
            document.getElementById('archivo-apuntes').value = '';
            document.getElementById('archivo-nombre').textContent = '';
            archivoApuntes = null;
            
            renderizarTemas();
        }

