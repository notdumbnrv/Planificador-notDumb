        // ============ ALGORITMO DE PLANIFICACIÓN v6.0 ============
        function generarPlanificacion() {
            if (estudiantes.length === 0 || profesores.length === 0) {
                alert('⚠️ Necesitas estudiantes y profesores');
                return;
            }

            console.log('=== INICIANDO PLANIFICACIÓN v6.0 ===');

            // PASO 1: Crear estructura de necesidades por estudiante
            // IMPORTANTE: Crear una entrada separada por cada hora solicitada
            const necesidadesEstudiantes = [];
            estudiantes.forEach(est => {
                est.temas.forEach(tema => {
                    // Distribuir horas equitativamente entre subtemas
                    const horasBase = Math.floor(tema.horas / tema.subtemas.length);
                    const horasExtra = tema.horas % tema.subtemas.length; // Horas que sobran

                    tema.subtemas.forEach((subtema, indexSubtema) => {
                        let nivelGrupo = 'MEDIO';
                        if (tema.nota < 5) nivelGrupo = 'MUY_BAJO';
                        else if (tema.nota < 7) nivelGrupo = 'BAJO';
                        else if (tema.nota < 8.5) nivelGrupo = 'ALTO';
                        else nivelGrupo = 'MUY_ALTO';

                        // Los primeros 'horasExtra' subtemas reciben una hora adicional
                        const horasParaEsteSubtema = horasBase + (indexSubtema < horasExtra ? 1 : 0);

                        // Crear una entrada POR CADA HORA solicitada
                        for (let h = 0; h < horasParaEsteSubtema; h++) {
                            necesidadesEstudiantes.push({
                                estudiante: est,
                                estudianteId: est.id,
                                estudianteNombre: est.nombre,
                                curso: est.curso,
                                asignatura: tema.asignatura,
                                tema: tema.tema,
                                subtema: subtema,
                                nota: tema.nota,
                                nivelGrupo: nivelGrupo,
                                disponibilidad: est.disponibilidad,
                                urgente: tema.urgente,
                                tiposClase: tema.tiposClase,
                                comentarios: tema.comentarios,
                                archivo: tema.archivo,
                                horaNumero: h + 1 // Para identificar cuál hora es
                            });
                        }
                    });
                });
            });

            console.log(`📊 Total de horas individuales a asignar: ${necesidadesEstudiantes.length}`);

            // PASO 2: Tracking de disponibilidad
            const estudiantesHorasDia = {};
            const estudianteSlotsOcupados = {};
            estudiantes.forEach(est => {
                estudiantesHorasDia[est.id] = { L: 0, M: 0, X: 0, J: 0, V: 0 };
                estudianteSlotsOcupados[est.id] = new Set();
            });

            const clases = [];
            const diasSemana = ['L', 'M', 'X', 'J', 'V'];
            const horas = ['15', '16', '17', '18', '19', '20'];

            // PASO 3: Definir cuándo se pueden agrupar cursos
            function puedenAgruparse(curso1, curso2) {
                // 1º Bach NUNCA con 2º Bach
                if ((curso1 === '1BAT' && curso2 === '2BAT') || (curso1 === '2BAT' && curso2 === '1BAT')) {
                    return false;
                }
                // 2º Bach SÍ puede con Selectividad
                if ((curso1 === '2BAT' && curso2 === 'SELECTIVIDAD') || (curso1 === 'SELECTIVIDAD' && curso2 === '2BAT')) {
                    return true;
                }
                // Mismo curso siempre puede agruparse
                return curso1 === curso2;
            }

            // PASO 4: Agrupar necesidades similares (teniendo en cuenta el curso)
            const grupos = {};
            necesidadesEstudiantes.forEach(nec => {
                const tiposClave = nec.tiposClase.sort().join('|') || 'NINGUNO';
                const key = `${nec.curso}|${nec.asignatura}|${nec.tema}|${nec.subtema}|${nec.nivelGrupo}|${tiposClave}`;
                if (!grupos[key]) {
                    grupos[key] = [];
                }
                grupos[key].push(nec);
            });

            console.log(`📦 Grupos creados: ${Object.keys(grupos).length}`);

            // PASO 5: Procesar cada grupo
            Object.keys(grupos).forEach(key => {
                const [curso, asignatura, tema, subtema, nivelGrupo, tiposClave] = key.split('|');
                const grupoNecesidades = grupos[key];
                
                console.log(`\n🔄 Procesando: ${asignatura} - ${subtema} - Nivel ${nivelGrupo} - Curso ${curso}`);
                console.log(`   Total horas en este grupo: ${grupoNecesidades.length}`);
                
                // Intentar asignar cada hora
                let intentos = 0;
                const maxIntentos = 500;
                
                while (grupoNecesidades.length > 0 && intentos < maxIntentos) {
                    intentos++;
                    
                    // Buscar el mejor slot para estas necesidades
                    let mejorSlot = null;
                    let mejorProfesor = null;
                    let estudiantesDisponibles = [];
                    
                    // Priorizar urgentes
                    grupoNecesidades.sort((a, b) => {
                        if (a.urgente && !b.urgente) return -1;
                        if (!a.urgente && b.urgente) return 1;
                        return 0;
                    });
                    
                    for (let dia of diasSemana) {
                        for (let hora of horas) {
                            const slot = `${dia}${hora}`;
                            
                            // Profesor disponible
                            const profDisponible = profesores.find(p => 
                                p.materias.includes(asignatura) &&
                                p.disponibilidad.includes(slot) &&
                                !clases.some(c => c.profesor.id === p.id && c.slot === slot)
                            );
                            
                            if (!profDisponible) continue;
                            
                            // ¿Qué necesidades pueden asistir a este slot?
                            const disponibles = grupoNecesidades.filter(nec => 
                                nec.disponibilidad.includes(slot) &&
                                estudiantesHorasDia[nec.estudianteId][dia] < 2 &&
                                !estudianteSlotsOcupados[nec.estudianteId].has(slot)
                            );
                            
                            if (disponibles.length === 0) continue;
                            
                            // Agrupar solo estudiantes del mismo curso o compatibles
                            const cursoBase = disponibles[0].curso;
                            const compatibles = disponibles.filter(nec => 
                                puedenAgruparse(cursoBase, nec.curso)
                            );
                            
                            // Maximizar número de estudiantes (hasta 10)
                            if (compatibles.length > estudiantesDisponibles.length) {
                                mejorSlot = slot;
                                mejorProfesor = profDisponible;
                                estudiantesDisponibles = compatibles.slice(0, 10); // Máx 10
                            }
                        }
                    }
                    
                    // Si encontramos un slot válido, crear la clase
                    if (mejorSlot && estudiantesDisponibles.length > 0) {
                        const dia = mejorSlot.charAt(0);
                        
                        // Obtener estudiantes únicos (sin duplicar el mismo estudiante en la misma clase)
                        const estudiantesUnicos = {};
                        estudiantesDisponibles.forEach(nec => {
                            if (!estudiantesUnicos[nec.estudianteId]) {
                                estudiantesUnicos[nec.estudianteId] = nec;
                            }
                        });
                        const necesidadesFinales = Object.values(estudiantesUnicos);
                        
                        // Crear la clase
                        const esUrgente = necesidadesFinales.some(nec => nec.urgente);
                        const esIndividual = necesidadesFinales.length === 1;
                        
                        clases.push({
                            tipo: esIndividual ? 'individual' : (necesidadesFinales.length >= 8 ? 'grupo' : 'pequeño'),
                            curso: necesidadesFinales[0].curso,
                            cursosEnClase: [...new Set(necesidadesFinales.map(n => n.curso))],
                            asignatura,
                            tema,
                            subtema,
                            nivelGrupo,
                            estudiantes: necesidadesFinales.map(nec => nec.estudiante),
                            nombresAlumnos: necesidadesFinales.map(nec => nec.estudianteNombre),
                            ubicaciones: [...new Set(necesidadesFinales.map(nec => `${nec.estudiante.ciudad} (${nec.estudiante.comunidad})`))],
                            tiposClase: [...new Set(necesidadesFinales.flatMap(nec => nec.tiposClase))],
                            profesor: mejorProfesor,
                            slot: mejorSlot,
                            capacidad: necesidadesFinales.length,
                            urgente: esUrgente,
                            comentarios: necesidadesFinales.filter(nec => nec.comentarios).map(nec => `${nec.estudianteNombre}: ${nec.comentarios}`),
                            apuntes: necesidadesFinales.filter(nec => nec.archivo).map(nec => ({nombre: nec.estudianteNombre, archivo: nec.archivo}))
                        });
                        
                        // Actualizar tracking
                        necesidadesFinales.forEach(nec => {
                            estudiantesHorasDia[nec.estudianteId][dia]++;
                            estudianteSlotsOcupados[nec.estudianteId].add(mejorSlot);
                        });
                        
                        // Eliminar las necesidades asignadas
                        necesidadesFinales.forEach(necAsignada => {
                            const idx = grupoNecesidades.findIndex(n => 
                                n.estudianteId === necAsignada.estudianteId && 
                                n.subtema === necAsignada.subtema &&
                                n.horaNumero === necAsignada.horaNumero
                            );
                            if (idx !== -1) {
                                grupoNecesidades.splice(idx, 1);
                            }
                        });
                        
                        console.log(`   ✅ Clase ${mejorSlot}: ${necesidadesFinales.map(n => n.estudianteNombre).join(', ')}`);
                    } else {
                        console.log(`   ⚠️ No se encontró slot disponible para este grupo. Quedan ${grupoNecesidades.length} horas sin asignar.`);
                        break;
                    }
                }
                
                if (grupoNecesidades.length > 0) {
                    console.log(`   ❌ Quedan ${grupoNecesidades.length} horas sin asignar en este grupo después de ${intentos} intentos`);
                }
            });

            // PASO 6: Verificar horas no asignadas
            const horasAsignadas = clases.length;
            const horasSolicitadas = necesidadesEstudiantes.length;
            const horasNoAsignadas = horasSolicitadas - horasAsignadas;
            const tasaAsignacion = ((horasAsignadas / horasSolicitadas) * 100).toFixed(1);
            
            console.log(`\n📊 RESULTADOS FINALES:`);
            console.log(`   - Total horas solicitadas: ${horasSolicitadas}`);
            console.log(`   - Clases creadas: ${clases.length}`);
            console.log(`   - Horas asignadas: ${horasAsignadas}`);
            console.log(`   - Horas sin asignar: ${horasNoAsignadas}`);
            console.log(`   - Tasa de asignación: ${tasaAsignacion}%`);

            planificacion = { 
                clases,
                necesidadesEstudiantes,
                sinAsignar: horasNoAsignadas,
                totalSolicitado: horasSolicitadas,
                tasaAsignacion: tasaAsignacion
            };
            
            document.getElementById('btn-calendario').classList.remove('hidden');
            cambiarVista('calendario');
            renderizarCalendario();
            
            if (horasNoAsignadas > 0) {
                setTimeout(() => {
                    alert(`⚠️ ATENCIÓN: ${horasNoAsignadas} horas NO pudieron asignarse.\n\nPosibles soluciones:\n• Agregar más profesores\n• Ampliar disponibilidad horaria de estudiantes\n• Ampliar disponibilidad de profesores\n\nTasa de asignación actual: ${tasaAsignacion}%`);
                }, 500);
            } else {
                setTimeout(() => {
                    alert(`✅ ¡PERFECTO! Todas las ${clases.length} horas solicitadas fueron asignadas correctamente.\n\nTasa de asignación: 100%`);
                }, 500);
            }
        }

        function renderizarCalendario() {
            const grid = document.getElementById('calendario-grid');
            const diasNombres = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'];
            const horas = ['15:00', '16:00', '17:00', '18:00', '19:00', '20:00'];
            const diasCodigos = ['L', 'M', 'X', 'J', 'V'];

            let html = '<div class="calendario-header">Hora</div>';
            diasNombres.forEach(dia => {
                html += `<div class="calendario-header">${dia}</div>`;
            });

            horas.forEach(hora => {
                html += `<div class="calendario-hora">${hora}-${parseInt(hora.split(':')[0]) + 1}:00</div>`;
                
                diasCodigos.forEach(dia => {
                    const slot = `${dia}${hora.split(':')[0]}`;
                    const clasesEnSlot = planificacion.clases.filter(c => c.slot === slot);
                    
                    let celdaHtml = '';
                    clasesEnSlot.forEach(clase => {
                        const tipoClass = clase.tipo;
                        const urgenteClass = clase.urgente ? ' urgente' : '';
                        const urgenteIcon = clase.urgente ? ' 🔥' : '';
                        const individualBadge = clase.tipo === 'individual' ? ' <span class="badge-individual">1:1</span>' : '';
                        
                        // Badge de nivel
                        let nivelTexto = '';
                        let nivelClass = '';
                        switch(clase.nivelGrupo) {
                            case 'MUY_BAJO': nivelTexto = 'Nivel 0-5'; nivelClass = 'nivel-bajo'; break;
                            case 'BAJO': nivelTexto = 'Nivel 5-7'; nivelClass = 'nivel-bajo'; break;
                            case 'MEDIO': nivelTexto = 'Nivel 7-8.5'; nivelClass = 'nivel-alto'; break;
                            case 'ALTO': nivelTexto = 'Nivel 8.5+'; nivelClass = 'nivel-alto'; break;
                            case 'MUY_ALTO': nivelTexto = 'Nivel 9+'; nivelClass = 'nivel-alto'; break;
                        }
                        const nivelBadge = `<span class="nivel-badge ${nivelClass}">${nivelTexto}</span>`;
                        
                        // Info de cursos
                        const cursosInfo = clase.cursosEnClase.length > 1 ? 
                            `<div style="font-size: 0.85em; margin-top: 3px; color: #92400e;">📚 Cursos: ${clase.cursosEnClase.join(' + ')}</div>` : 
                            `<div style="font-size: 0.85em; margin-top: 3px; color: #92400e;">📚 Curso: ${clase.curso}</div>`;
                        
                        celdaHtml += `
                            <div class="clase-en-calendario ${tipoClass}${urgenteClass}">
                                <div class="clase-materia">${clase.asignatura}${urgenteIcon}${individualBadge}</div>
                                <div class="clase-tema">${clase.tema} → ${clase.subtema}</div>
                                ${cursosInfo}
                                <div style="margin: 3px 0;">${nivelBadge}</div>
                                <div class="clase-alumnos">${clase.capacidad} alumno(s) · ${clase.profesor.nombre}</div>
                                <div class="clase-nombres">
                                    <strong>Alumnos:</strong><br>
                                    ${clase.nombresAlumnos.map(n => '• ' + n).join('<br>')}
                                </div>
                                <div style="font-size: 0.85em; margin-top: 3px; color: #92400e;">
                                    📍 ${clase.ubicaciones.join(', ')}
                                </div>
                        `;
                        
                        if (clase.tiposClase.length > 0) {
                            celdaHtml += `<div style="font-size: 0.85em; margin-top: 3px; color: #92400e;">🎯 ${clase.tiposClase.join(', ')}</div>`;
                        }
                        
                        if (clase.apuntes && clase.apuntes.length > 0) {
                            celdaHtml += '<div style="margin-top: 5px;">';
                            clase.apuntes.forEach(ap => {
                                celdaHtml += `<div class="apuntes-link" title="Ver apuntes">📚 ${ap.nombre}: ${ap.archivo}</div>`;
                            });
                            celdaHtml += '</div>';
                        }
                        
                        if (clase.comentarios && clase.comentarios.length > 0) {
                            celdaHtml += '<div class="clase-comentarios">';
                            clase.comentarios.forEach(com => {
                                celdaHtml += `📝 ${com}<br>`;
                            });
                            celdaHtml += '</div>';
                        }
                        
                        celdaHtml += '</div>';
                    });
                    
                    html += `<div class="calendario-celda">${celdaHtml}</div>`;
                });
            });

            grid.innerHTML = html;

            // Resumen
            const totalClases = planificacion.clases.length;
            const clasesGrupo = planificacion.clases.filter(c => c.tipo === 'grupo').length;
            const clasesIndividuales = planificacion.clases.filter(c => c.tipo === 'individual').length;
            const clasesUrgentes = planificacion.clases.filter(c => c.urgente).length;
            const horasAsignadas = planificacion.clases.length;
            const horasSolicitadas = planificacion.totalSolicitado;
            const tasaAsignacion = planificacion.tasaAsignacion;
            const sinAsignar = planificacion.sinAsignar;

            // Análisis de discriminación por curso
            const clasesMixtas = planificacion.clases.filter(c => c.cursosEnClase.length > 1);
            const clases1Bach = planificacion.clases.filter(c => c.cursosEnClase.includes('1BAT')).length;
            const clases2Bach = planificacion.clases.filter(c => c.cursosEnClase.includes('2BAT')).length;
            const clasesSelectividad = planificacion.clases.filter(c => c.cursosEnClase.includes('SELECTIVIDAD')).length;

            const horasProfesores = {};
            profesores.forEach(prof => {
                horasProfesores[prof.id] = {
                    nombre: prof.nombre,
                    disponibles: prof.disponibilidad.length,
                    usadas: planificacion.clases.filter(c => c.profesor.id === prof.id).length
                };
            });

            let resumenProfs = '<div style="margin-top: 20px;"><h3 style="color: #9a3412; margin-bottom: 10px;">👨‍🏫 Uso de Profesores</h3><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 10px;">';
            Object.values(horasProfesores).forEach(prof => {
                const porcentaje = (prof.usadas / prof.disponibles * 100).toFixed(0);
                const color = porcentaje > 80 ? '#22c55e' : porcentaje > 50 ? '#f59e0b' : '#ef4444';
                resumenProfs += `
                    <div style="background: white; border: 2px solid #fed7aa; border-radius: 10px; padding: 15px;">
                        <div style="font-weight: bold; color: #9a3412; margin-bottom: 5px;">${prof.nombre}</div>
                        <div style="color: #92400e;">Clases: ${prof.usadas}/${prof.disponibles}</div>
                        <div style="margin-top: 8px; background: #fed7aa; height: 8px; border-radius: 4px; overflow: hidden;">
                            <div style="background: ${color}; height: 100%; width: ${porcentaje}%;"></div>
                        </div>
                        <div style="text-align: center; margin-top: 5px; font-weight: bold; color: ${color};">${porcentaje}% ocupado</div>
                    </div>
                `;
            });
            resumenProfs += '</div></div>';

            const alertClass = sinAsignar > 0 ? 'alert-warning' : 'alert-success';
            const alertIcon = sinAsignar > 0 ? '⚠️' : '✅';
            const alertMsg = sinAsignar > 0 
                ? `<strong>ATENCIÓN:</strong> ${sinAsignar} horas NO fueron asignadas. Tasa de asignación: ${tasaAsignacion}%`
                : `<strong>¡PERFECTO!</strong> Todas las horas solicitadas fueron asignadas. Tasa de asignación: 100%`;

            document.getElementById('resumen-planificacion').innerHTML = `
                <div class="alert ${alertClass}">
                    <span style="font-size: 1.5em;">${alertIcon}</span>
                    <div>${alertMsg}</div>
                </div>

                <div class="alert alert-info">
                    <span style="font-size: 1.5em;">📚</span>
                    <div>
                        <strong>Discriminación por Curso:</strong><br>
                        • Total clases 1º Bach: ${clases1Bach}<br>
                        • Total clases 2º Bach: ${clases2Bach}<br>
                        • Total clases Selectividad: ${clasesSelectividad}<br>
                        • Clases mixtas (2º Bach + Selectividad): ${clasesMixtas.length}<br>
                        • ✅ NO hay mezclas de 1º Bach con 2º Bach
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-value">${totalClases}</div>
                        <div class="stat-label">Clases Totales</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">${clasesGrupo}</div>
                        <div class="stat-label">Clases Grupales (8-10)</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">${clasesIndividuales}</div>
                        <div class="stat-label">Clases Individuales 1:1</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">${clasesUrgentes}</div>
                        <div class="stat-label">Clases Urgentes 🔥</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">${horasAsignadas}/${horasSolicitadas}</div>
                        <div class="stat-label">Horas Asignadas</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: ${sinAsignar > 0 ? '#dc2626' : '#22c55e'};">${tasaAsignacion}%</div>
                        <div class="stat-label">Tasa de Asignación</div>
                    </div>
                </div>

                ${resumenProfs}
            `;
        }

        // ============ INICIALIZACIÓN ============
        window.onload = function() {
            console.log('=== INICIALIZANDO PLANIFICADOR v6.0 ===');
            
            // Cargar comunidades autónomas
            cargarComunidades();
            
            // Profesores de ejemplo
            profesores = [
                { id: 1, nombre: 'Prof. Elena Torres', materias: ['Matemáticas'], disponibilidad: ['L15','L16','L17','M16','M17','X15','X16','J16','J17','V15','V16'] },
                { id: 2, nombre: 'Prof. Miguel Fernández', materias: ['Física', 'Química'], disponibilidad: ['L16','L17','L18','M15','M16','X17','X18','J15','J16','V17','V18'] },
                { id: 3, nombre: 'Prof. Carmen Rodríguez', materias: ['Química', 'Biología'], disponibilidad: ['L18','L19','M17','M18','X16','X17','J17','J18','V16','V17'] }
            ];
            contadorProfId = 4;
            
            renderizarProfesores();
            renderizarTemas();
            
            console.log('=== PLANIFICADOR v6.0 LISTO ===');
        };
    </script>
