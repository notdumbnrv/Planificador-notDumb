            const nombre = document.getElementById('est-nombre').value;
            const curso = document.getElementById('est-curso').value;
            const comunidad = document.getElementById('est-comunidad').value;
            const provincia = document.getElementById('est-provincia').value;
            const ciudad = document.getElementById('est-ciudad').value;
            const instituto = document.getElementById('est-instituto').value.trim();
            const disponibilidad = Array.from(document.querySelectorAll('.disp-check:checked')).map(cb => cb.value);

            if (!nombre || !curso || !comunidad || !provincia || !ciudad || !instituto || disponibilidad.length === 0) {
                alert('⚠️ Completa todos los campos obligatorios');
                return;
            }

            // Validar duplicados
            const estudianteDuplicado = estudiantes.find(e =>
                e.nombre.toLowerCase() === nombre.toLowerCase() &&
                e.curso === curso
            );
            if (estudianteDuplicado) {
                if (!confirm(`⚠️ Ya existe un estudiante llamado "${nombre}" en el curso ${curso}.\n\n¿Deseas agregarlo de todas formas?`)) {
                    return;
                }
            }

            if (temasTemp.length === 0) {
                alert('⚠️ Agrega al menos un tema');
                return;
            }

            const totalHoras = temasTemp.reduce((sum, t) => sum + t.horas, 0);
            if (totalHoras > 10) {
                alert('⚠️ Máximo 10 horas semanales');
                return;
            }

            estudiantes.push({
                id: contadorEstId++,
                nombre, curso, comunidad, provincia, ciudad, instituto,
                disponibilidad,
                temas: JSON.parse(JSON.stringify(temasTemp))
            });
            
            // Limpiar
            document.getElementById('est-nombre').value = '';
            document.getElementById('est-curso').value = '';
            document.getElementById('est-comunidad').value = '';
            document.getElementById('est-provincia').value = '';
            document.getElementById('est-ciudad').value = '';
            document.getElementById('est-instituto').value = '';
            document.querySelectorAll('.disp-check').forEach(cb => cb.checked = false);
            temasTemp = [];
            archivoApuntes = null; // Resetear el archivo para evitar referencias residuales
            renderizarTemas();
            
            alert(`✅ Estudiante guardado con ${totalHoras} hora(s)`);
            renderizarEstudiantes();
        }

