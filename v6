<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>notDumb.es - Planificador v6.0 MEJORADO</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #fff5f0 0%, #ffe4d6 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container { max-width: 1800px; margin: 0 auto; }
        .header {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            padding: 30px; border-radius: 15px; color: white;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(249, 115, 22, 0.3);
        }
        .logo { font-size: 2em; font-weight: bold; margin-bottom: 10px; }
        .nav-buttons { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
        .nav-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.4);
            color: white; padding: 12px 20px; border-radius: 10px;
            cursor: pointer; font-weight: 600; transition: all 0.3s;
        }
        .nav-btn:hover { background: rgba(255, 255, 255, 0.3); }
        .nav-btn.active { background: white; color: #f97316; }
        .card {
            background: white; border-radius: 15px; padding: 30px;
            margin-bottom: 20px; box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }
        .card-title {
            font-size: 1.5em; color: #9a3412;
            margin-bottom: 20px; font-weight: bold;
        }
        .form-group { margin-bottom: 20px; }
        .form-label {
            display: block; font-weight: 600;
            color: #9a3412; margin-bottom: 8px;
        }
        .form-input, .form-select, textarea {
            width: 100%; padding: 12px;
            border: 2px solid #fed7aa; border-radius: 8px;
            font-size: 1em; font-family: inherit;
        }
        .form-input:focus, .form-select:focus, textarea:focus {
            outline: none; border-color: #f97316;
        }
        .btn-primary {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            color: white; border: none; padding: 12px 24px;
            border-radius: 10px; font-weight: 600;
            cursor: pointer; transition: all 0.3s;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(249, 115, 22, 0.3);
        }
        .btn-secondary {
            background: white; color: #f97316;
            border: 2px solid #f97316; padding: 8px 16px;
            border-radius: 8px; font-weight: 600;
            cursor: pointer; font-size: 0.9em;
        }
        .asignatura-item {
            background: #fff7ed; border: 2px solid #fed7aa;
            border-radius: 10px; padding: 15px;
            margin-bottom: 15px; position: relative;
        }
        .btn-remove {
            position: absolute; top: 10px; right: 10px;
            background: #fee2e2; color: #991b1b;
            border: none; padding: 4px 8px;
            border-radius: 6px; cursor: pointer; font-size: 0.85em;
        }
        .calendario-semanal { overflow-x: auto; margin-top: 20px; }
        .calendario-grid {
            display: grid;
            grid-template-columns: 80px repeat(5, 1fr);
            gap: 1px; background: #fed7aa;
            border: 2px solid #fed7aa; border-radius: 10px;
            overflow: hidden; min-width: 900px;
        }
        .calendario-header {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            color: white; padding: 12px;
            font-weight: bold; text-align: center;
        }
        .calendario-hora {
            background: #fff7ed; padding: 12px;
            font-weight: 600; text-align: center;
            font-size: 0.9em; color: #9a3412;
        }
        .calendario-celda {
            background: white; padding: 8px;
            min-height: 120px; position: relative;
            transition: all 0.2s;
        }
        .calendario-celda:hover { background: #fffbeb; }
        .clase-en-calendario {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border: 2px solid #fbbf24; border-radius: 6px;
            padding: 8px; margin-bottom: 4px;
            font-size: 0.70em; line-height: 1.4;
        }
        .clase-en-calendario.grupo {
            background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
            border-color: #22c55e;
        }
        .clase-en-calendario.individual {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            border-color: #3b82f6;
        }
        .clase-en-calendario.urgente {
            border: 3px solid #dc2626;
            box-shadow: 0 0 10px rgba(220, 38, 38, 0.3);
        }
        .clase-materia { font-weight: bold; color: #78350f; }
        .clase-tema { color: #92400e; margin-top: 2px; font-size: 0.95em; }
        .clase-alumnos {
            color: #a16207; font-size: 0.9em; margin-top: 3px;
        }
        .clase-nombres {
            background: #fef3c7; padding: 5px; margin-top: 5px;
            border-radius: 3px; font-size: 0.85em;
            color: #92400e; max-height: 60px; overflow-y: auto;
        }
        .clase-comentarios {
            background: #fef3c7; border-left: 3px solid #f59e0b;
            padding: 6px; margin-top: 5px; font-size: 0.9em;
            color: #92400e; border-radius: 3px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px; margin-bottom: 20px;
        }
        .stat-card {
            background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
            padding: 20px; border-radius: 12px;
            border: 2px solid #fed7aa; text-align: center;
        }
        .stat-value {
            font-size: 2em; font-weight: bold; color: #ea580c;
        }
        .stat-label {
            color: #9a3412; margin-top: 8px;
            font-weight: 600; font-size: 0.9em;
        }
        .alert {
            padding: 15px 20px; border-radius: 10px;
            margin-bottom: 20px; display: flex;
            align-items: center; gap: 10px;
        }
        .alert-success {
            background: #f0fdf4; color: #166534;
            border: 2px solid #bbf7d0;
        }
        .alert-info {
            background: #eff6ff; color: #1e40af;
            border: 2px solid #bfdbfe;
        }
        .alert-warning {
            background: #fef3c7; color: #92400e;
            border: 2px solid #fde68a;
        }
        .hidden { display: none; }
        .form-grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }
        .form-grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        .badge-urgente {
            background: #fee2e2; color: #991b1b;
            padding: 3px 8px; border-radius: 12px;
            font-size: 0.85em; font-weight: bold;
            display: inline-block; margin-left: 5px;
        }
        .badge-individual {
            background: #dbeafe; color: #1e40af;
            padding: 3px 8px; border-radius: 12px;
            font-size: 0.85em; font-weight: bold;
            display: inline-block; margin-left: 5px;
        }
        table { width: 100%; border-collapse: collapse; }
        th {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            color: white; padding: 12px; text-align: left; font-weight: 600;
        }
        td { padding: 12px; border-bottom: 1px solid #fed7aa; }
        tbody tr:hover { background: #fff7ed; }
        .profesor-card {
            background: white; border: 2px solid #fed7aa;
            border-radius: 10px; padding: 15px; margin-bottom: 15px;
            position: relative;
        }
        .profesor-nombre {
            font-size: 1.2em; font-weight: bold;
            color: #9a3412; margin-bottom: 10px;
        }
        .btn-eliminar-prof {
            position: absolute; top: 10px; right: 10px;
            background: #fee2e2; color: #991b1b;
            border: none; padding: 6px 12px;
            border-radius: 6px; cursor: pointer;
            font-size: 0.85em; font-weight: 600;
        }
        .checkbox-group {
            display: flex; flex-direction: column; gap: 8px;
        }
        .checkbox-group label {
            display: flex; align-items: center; gap: 8px;
            cursor: pointer;
        }
        .subtema-checkbox {
            background: #fff7ed; border: 2px solid #fed7aa;
            padding: 10px; border-radius: 8px; margin: 5px 0;
        }
        .file-upload-btn {
            background: #f0fdf4; border: 2px dashed #22c55e;
            padding: 15px; border-radius: 8px; text-align: center;
            cursor: pointer; transition: all 0.3s;
        }
        .file-upload-btn:hover {
            background: #dcfce7;
        }
        .nivel-badge {
            display: inline-block;
            padding: 4px 10px; border-radius: 12px;
            font-size: 0.85em; font-weight: 600;
        }
        .nivel-bajo { background: #fee2e2; color: #991b1b; }
        .nivel-alto { background: #dcfce7; color: #166534; }
        .apuntes-link {
            background: #dcfce7;
            border: 2px solid #22c55e;
            padding: 8px 12px;
            border-radius: 6px;
            display: inline-block;
            margin-top: 5px;
            color: #166534;
            font-weight: 600;
            font-size: 0.9em;
            cursor: pointer;
            transition: all 0.2s;
        }
        .apuntes-link:hover {
            background: #bbf7d0;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">notDumb.es - Planificador v6.0 🎯 MEJORADO</div>
            <div style="opacity: 0.9; font-size: 1.1em;">
                ✅ Instituto como texto libre · ✅ Discriminación por curso · ✅ Temarios actualizados<br>
                ✅ Todos reciben sus horas · ✅ Distribución óptima de horarios
            </div>
            <div class="nav-buttons">
                <button class="nav-btn active" onclick="cambiarVista('estudiantes', event)">👥 Estudiantes</button>
                <button class="nav-btn" onclick="cambiarVista('profesores', event)">👨‍🏫 Profesores</button>
                <button class="nav-btn" onclick="cambiarVista('planificar', event)">⚙️ Planificar</button>
                <button class="nav-btn hidden" id="btn-calendario" onclick="cambiarVista('calendario', event)">📅 Calendario</button>
            </div>
        </div>

        <!-- VISTA: ESTUDIANTES -->
        <div id="vista-estudiantes">
            <div class="card">
                <div class="card-title">👥 Registro de Estudiantes</div>
                
                <div class="alert alert-info">
                    <span style="font-size: 1.5em;">✨</span>
                    <div>
                        <strong>NUEVO v6.0:</strong> 
                        • Instituto ahora es campo libre para escribir<br>
                        • Nunca se juntan 1º Bach con 2º Bach (2º Bach SÍ puede con Selectividad)<br>
                        • Temarios completos de 1º y 2º Bach actualizados<br>
                        • TODOS los alumnos reciben el 100% de sus horas (incluso individual si es necesario)<br>
                        • Si pides 3h de una materia, se distribuyen en 3 slots diferentes
                    </div>
                </div>

                <div style="background: #fffbeb; padding: 20px; border-radius: 10px; border: 2px solid #fef3c7; margin-bottom: 20px;">
                    <h3 style="color: #9a3412; margin-bottom: 15px;">📝 Datos del Estudiante</h3>
                    
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label">Nombre Completo *</label>
                            <input type="text" class="form-input" id="est-nombre" placeholder="Ej: María García">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Curso *</label>
                            <select class="form-select" id="est-curso" onchange="actualizarTemasDisponibles()">
                                <option value="">Seleccionar...</option>
                                <option value="1BAT">1º Bachillerato</option>
                                <option value="2BAT">2º Bachillerato</option>
                                <option value="SELECTIVIDAD">Selectividad</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Comunidad Autónoma *</label>
                            <select class="form-select" id="est-comunidad" onchange="actualizarProvincias()">
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Provincia *</label>
                            <select class="form-select" id="est-provincia" onchange="actualizarCiudades()">
                                <option value="">Primero selecciona comunidad</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Ciudad *</label>
                            <select class="form-select" id="est-ciudad">
                                <option value="">Primero selecciona provincia</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Instituto * (escribe el nombre)</label>
                            <input type="text" class="form-input" id="est-instituto" placeholder="Ej: IES Miguel de Cervantes">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Disponibilidad Horaria *</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 6px; margin-top: 10px;">
                            <label><input type="checkbox" class="disp-check" value="L15"> L 15-16</label>
                            <label><input type="checkbox" class="disp-check" value="L16"> L 16-17</label>
                            <label><input type="checkbox" class="disp-check" value="L17"> L 17-18</label>
                            <label><input type="checkbox" class="disp-check" value="L18"> L 18-19</label>
                            <label><input type="checkbox" class="disp-check" value="L19"> L 19-20</label>
                            <label><input type="checkbox" class="disp-check" value="L20"> L 20-21</label>
                            <label><input type="checkbox" class="disp-check" value="M15"> M 15-16</label>
                            <label><input type="checkbox" class="disp-check" value="M16"> M 16-17</label>
                            <label><input type="checkbox" class="disp-check" value="M17"> M 17-18</label>
                            <label><input type="checkbox" class="disp-check" value="M18"> M 18-19</label>
                            <label><input type="checkbox" class="disp-check" value="M19"> M 19-20</label>
                            <label><input type="checkbox" class="disp-check" value="M20"> M 20-21</label>
                            <label><input type="checkbox" class="disp-check" value="X15"> X 15-16</label>
                            <label><input type="checkbox" class="disp-check" value="X16"> X 16-17</label>
                            <label><input type="checkbox" class="disp-check" value="X17"> X 17-18</label>
                            <label><input type="checkbox" class="disp-check" value="X18"> X 18-19</label>
                            <label><input type="checkbox" class="disp-check" value="X19"> X 19-20</label>
                            <label><input type="checkbox" class="disp-check" value="X20"> X 20-21</label>
                            <label><input type="checkbox" class="disp-check" value="J15"> J 15-16</label>
                            <label><input type="checkbox" class="disp-check" value="J16"> J 16-17</label>
                            <label><input type="checkbox" class="disp-check" value="J17"> J 17-18</label>
                            <label><input type="checkbox" class="disp-check" value="J18"> J 18-19</label>
                            <label><input type="checkbox" class="disp-check" value="J19"> J 19-20</label>
                            <label><input type="checkbox" class="disp-check" value="J20"> J 20-21</label>
                            <label><input type="checkbox" class="disp-check" value="V15"> V 15-16</label>
                            <label><input type="checkbox" class="disp-check" value="V16"> V 16-17</label>
                            <label><input type="checkbox" class="disp-check" value="V17"> V 17-18</label>
                            <label><input type="checkbox" class="disp-check" value="V18"> V 18-19</label>
                            <label><input type="checkbox" class="disp-check" value="V19"> V 19-20</label>
                            <label><input type="checkbox" class="disp-check" value="V20"> V 20-21</label>
                        </div>
                    </div>

                    <hr style="margin: 25px 0; border: none; border-top: 2px solid #fed7aa;">

                    <h4 style="color: #9a3412; margin-bottom: 15px;">📚 Temas y Subtemas</h4>
                    <div id="asignaturas-lista"></div>
                    
                    <div class="form-grid-2" style="margin-top: 15px;">
                        <div class="form-group">
                            <label class="form-label">Asignatura *</label>
                            <select class="form-select" id="nueva-asignatura" onchange="actualizarTemas()">
                                <option value="">Primero selecciona curso</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Tema *</label>
                            <select class="form-select" id="nuevo-tema" onchange="actualizarSubtemas()">
                                <option value="">Primero selecciona asignatura</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Subtemas que necesita * (Selecciona todos los que apliquen)</label>
                        <div id="subtemas-disponibles" style="background: #fff7ed; padding: 15px; border-radius: 8px; border: 2px solid #fed7aa;">
                            <p style="color: #9a3412; font-style: italic;">Primero selecciona un tema</p>
                        </div>
                    </div>
                    
                    <div class="form-grid-3" style="margin-top: 10px;">
                        <div class="form-group">
                            <label class="form-label">Última Nota (0-10) *</label>
                            <input type="number" class="form-input" id="nueva-nota" min="0" max="10" step="0.5" value="5">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Horas Totales *</label>
                            <input type="number" class="form-input" id="nuevas-horas" min="1" max="10" value="2">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Fecha Examen (Opcional)</label>
                            <input type="date" class="form-input" id="nueva-fecha-examen">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">📚 Subir Apuntes/Libro (PDF o Imagen)</label>
                        <input type="file" id="archivo-apuntes" accept=".pdf,.jpg,.jpeg,.png" style="display: none;" onchange="mostrarArchivoSeleccionado()">
                        <div class="file-upload-btn" onclick="document.getElementById('archivo-apuntes').click()">
                            <div style="font-size: 2em; margin-bottom: 10px;">📤</div>
                            <div style="font-weight: 600; color: #166534;">Click para subir apuntes</div>
                            <div style="font-size: 0.85em; color: #166534; margin-top: 5px;">PDF, JPG o PNG</div>
                            <div id="archivo-nombre" style="margin-top: 10px; font-weight: bold; color: #9a3412;"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">🎯 Tipo de Clase (Puedes marcar varias)</label>
                        <div class="checkbox-group">
                            <label>
                                <input type="checkbox" class="tipo-clase" value="Desde cero">
                                <span>📖 Desde cero - Necesito aprender el tema completo</span>
                            </label>
                            <label>
                                <input type="checkbox" class="tipo-clase" value="Problemas">
                                <span>🧮 Problemas - Necesito practicar ejercicios</span>
                            </label>
                            <label>
                                <input type="checkbox" class="tipo-clase" value="Repaso">
                                <span>✅ Repaso general - Dudas finales antes del examen</span>
                            </label>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">💬 Comentarios Adicionales</label>
                        <textarea class="form-input" id="nuevos-comentarios" rows="2" placeholder="Ej: Tengo dificultad con la notación, necesito ejemplos prácticos..."></textarea>
                    </div>
                    
                    <button class="btn-primary" onclick="agregarTema()" style="width: 100%;">+ Agregar Tema/Subtemas</button>

                    <div style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #fed7aa;">
                        <button class="btn-primary" onclick="guardarEstudiante()" style="font-size: 1.1em; padding: 15px 30px;">
                            ✅ GUARDAR ESTUDIANTE
                        </button>
                    </div>
                </div>

                <div class="card-title" style="margin-top: 30px;">📋 Estudiantes Registrados</div>
                <div id="lista-estudiantes"></div>
            </div>
        </div>

        <!-- VISTA: PROFESORES -->
        <div id="vista-profesores" class="hidden">
            <div class="card">
                <div class="card-title">👨‍🏫 Gestión de Profesores</div>
                
                <div style="background: #fffbeb; padding: 20px; border-radius: 10px; border: 2px solid #fef3c7; margin-bottom: 20px;">
                    <h3 style="color: #9a3412; margin-bottom: 15px;">📝 Agregar Profesor</h3>
                    
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label">Nombre *</label>
                            <input type="text" class="form-input" id="prof-nombre">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Asignaturas *</label>
                            <div style="display: flex; gap: 15px; margin-top: 5px;">
                                <label><input type="checkbox" class="prof-materia" value="Matemáticas"> Matemáticas</label>
                                <label><input type="checkbox" class="prof-materia" value="Física"> Física</label>
                                <label><input type="checkbox" class="prof-materia" value="Química"> Química</label>
                                <label><input type="checkbox" class="prof-materia" value="Biología"> Biología</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Disponibilidad *</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 6px;">
                            <label><input type="checkbox" class="prof-disp" value="L15"> L 15-16</label>
                            <label><input type="checkbox" class="prof-disp" value="L16"> L 16-17</label>
                            <label><input type="checkbox" class="prof-disp" value="L17"> L 17-18</label>
                            <label><input type="checkbox" class="prof-disp" value="L18"> L 18-19</label>
                            <label><input type="checkbox" class="prof-disp" value="L19"> L 19-20</label>
                            <label><input type="checkbox" class="prof-disp" value="L20"> L 20-21</label>
                            <label><input type="checkbox" class="prof-disp" value="M15"> M 15-16</label>
                            <label><input type="checkbox" class="prof-disp" value="M16"> M 16-17</label>
                            <label><input type="checkbox" class="prof-disp" value="M17"> M 17-18</label>
                            <label><input type="checkbox" class="prof-disp" value="M18"> M 18-19</label>
                            <label><input type="checkbox" class="prof-disp" value="M19"> M 19-20</label>
                            <label><input type="checkbox" class="prof-disp" value="M20"> M 20-21</label>
