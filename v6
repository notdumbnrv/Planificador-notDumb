        function eliminarProfesor(id) {
            const profesorAEliminar = profesores.find(p => p.id === id);
            if (!profesorAEliminar) {
                alert('❌ Error: Profesor no encontrado');
                return;
            }

            // Verificar si el profesor tiene clases asignadas en la planificación actual
            if (planificacion && planificacion.clases) {
                const clasesDelProfesor = planificacion.clases.filter(c => c.profesorId === id);
                if (clasesDelProfesor.length > 0) {
                    alert(`⚠️ No se puede eliminar al profesor "${profesorAEliminar.nombre}" porque tiene ${clasesDelProfesor.length} clase(s) asignada(s) en la planificación actual.\n\nPrimero debes generar una nueva planificación sin este profesor.`);
                    return;
                }
            }

            if (!confirm('¿Seguro que deseas eliminar este profesor?')) return;

            profesores = profesores.filter(p => p.id !== id);
            renderizarProfesores();
            alert(`✅ Profesor "${profesorAEliminar.nombre}" eliminado`);
        }

